From 15211abaf2331a43855f09978bda20b030fffd25 Mon Sep 17 00:00:00 2001
From: "H. Vetinari" <h.vetinari@gmx.com>
Date: Thu, 1 Feb 2024 12:29:07 +0100
Subject: [PATCH] link libomp to compiler-rt on osx-arm

ADAPTED FOR AN IN-TREE BUILD (2026-09-07). Upstream's openmp feedstock builds
openmp STANDALONE against an INSTALLED clangdev + compiler-rt, so both of its
assumptions hold there and neither holds here:

  * `$ENV{PKG_VERSION_MAJOR}` is LLVM's major in that feedstock. In our stage
    PKG_VERSION is the stage's fixed 0.0.0, so the resource-dir path would come
    out as `lib/clang/0/lib` — or `lib/clang//lib` if rattler-build does not
    define the variable at all. Replaced with ACPP_LLVM_MAJOR, which the recipe
    passes to the build script for exactly this reason. This is the third time
    inherited logic reading a version number has been wrong for us.
  * `$ENV{PREFIX}` holds an installed compiler-rt there. In our single-configure
    in-tree build nothing is installed to $PREFIX until `ninja install` runs at
    the very end, long after libomp links — so the archive may legitimately not
    be there yet, and an unconditional `target_link_libraries` on a missing file
    is a hard link error an hour into a macOS build. Guarded with EXISTS and a
    status line either way, so the first real mac build REPORTS which branch it
    took instead of us guessing now. If the message says the builtins were not
    found and libomp then fails on undefined symbols, the fix is to point this
    at the in-tree compiler-rt output rather than the prefix.

The osx-arm64 leg has never been built, so both the original patch and this
adaptation are unproven; what is certain is that the original could not have
been right for this build shape.
---
 openmp/runtime/src/CMakeLists.txt | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/openmp/runtime/src/CMakeLists.txt b/openmp/runtime/src/CMakeLists.txt
index f106694841ce..6a016b76f4b6 100644
--- a/openmp/runtime/src/CMakeLists.txt
+++ b/openmp/runtime/src/CMakeLists.txt
@@ -175,6 +175,18 @@ if(OPENMP_STANDALONE_BUILD OR (NOT OPENMP_ENABLE_LIBOMP_PROFILING))
   set_property(TARGET omp PROPERTY FOLDER "OpenMP/Libraries")
   # Linking command will include libraries in LIBOMP_CONFIGURED_LIBFLAGS
   target_link_libraries(omp ${LIBOMP_CONFIGURED_LIBFLAGS} ${LIBOMP_DL_LIBS})
+  if(APPLE AND CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64")
+    cmake_path(SET CLANG_RT_BUILTINS_LIBRARY
+               NORMALIZE
+               "$ENV{PREFIX}/lib/clang/$ENV{ACPP_LLVM_MAJOR}/lib/libclang_rt.builtins_arm64_osx.a")
+    if(EXISTS "${CLANG_RT_BUILTINS_LIBRARY}")
+      message(STATUS "acpp: linking libomp against ${CLANG_RT_BUILTINS_LIBRARY}")
+      target_link_libraries(omp ${CLANG_RT_BUILTINS_LIBRARY})
+    else()
+      message(STATUS "acpp: compiler-rt builtins NOT present at ${CLANG_RT_BUILTINS_LIBRARY}"
+                     " -- libomp is linking without them (in-tree build, nothing installed yet)")
+    endif()
+  endif()
 else()
   add_llvm_library(omp ${LIBOMP_LIBRARY_KIND} ${LIBOMP_SOURCE_FILES} PARTIAL_SOURCES_INTENDED
     LINK_LIBS ${LIBOMP_CONFIGURED_LIBFLAGS} ${LIBOMP_DL_LIBS}
