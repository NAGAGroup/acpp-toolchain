# Everything text checks out LF on every platform. Windows runners check
# out with git's autocrlf by default, which turned every generated recipe
# into a CRLF copy that no longer matched what the generator emits, and
# would have done the same to every nushell script and licence text.
* text=auto eol=lf

# Windows shell scripts stay CRLF regardless of checkout platform.
*.bat text eol=crlf
*.ps1 text eol=crlf
