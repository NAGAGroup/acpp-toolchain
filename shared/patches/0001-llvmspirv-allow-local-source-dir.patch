Redirect AdaptiveCpp's SPIRV-LLVM-Translator ExternalProject at a local,
pinned checkout instead of a shallow clone of a moving branch, and forward the
build type into that sub-build.

The build-type forwarding matters on Windows: ExternalProject_Add passes only
the compilers, LLVM_DIR, install prefix and CXX flags, so the sub-build
configures with an EMPTY CMAKE_BUILD_TYPE. Its `--config Release` build command
is ignored by single-config generators (Ninja), so it selects a different MSVC
runtime than LLVM and the link dies with:

    lld-link: error: /failifmismatch: mismatch detected for '_ITERATOR_DEBUG_LEVEL'

diff --git a/src/compiler/llvm-to-backend/CMakeLists.txt b/src/compiler/llvm-to-backend/CMakeLists.txt
index 98066dd..fb0f2aa 100644
--- a/src/compiler/llvm-to-backend/CMakeLists.txt
+++ b/src/compiler/llvm-to-backend/CMakeLists.txt
@@ -182,16 +182,14 @@ if(WITH_SSCP_COMPILER)
     set(LLVMSPIRV_RELATIVE_PATH ${LLVMSPIRV_RELATIVE_INSTALLDIR}/bin/llvm-spirv)
 
     ExternalProject_Add(LLVMSpirvTranslator
-      GIT_REPOSITORY https://github.com/AdaptiveCpp/SPIRV-LLVM-Translator
-      GIT_TAG origin/${LLVMSPIRV_BRANCH}
-      GIT_SHALLOW ON
-      GIT_REMOTE_UPDATE_STRATEGY CHECKOUT
+      SOURCE_DIR ${LLVMSPIRV_SOURCE_DIR}
       BUILD_ALWAYS OFF
       BINARY_DIR ${CMAKE_CURRENT_BINARY_DIR}/ext/llvm-spirv
       CMAKE_ARGS
         -DCMAKE_C_COMPILER:PATH=${CMAKE_C_COMPILER}
         -DCMAKE_CXX_COMPILER:PATH=${CMAKE_CXX_COMPILER}
       CMAKE_CACHE_ARGS
+        -DCMAKE_BUILD_TYPE:STRING=${CMAKE_BUILD_TYPE}
         -DLLVM_SPIRV_BUILD_EXTERNAL:BOOL=YES
         -DLLVM_DIR:PATH=${LLVM_DIR}
         -DCMAKE_INSTALL_PREFIX:PATH=${LLVMSPIRV_INSTALLDIR}
