Let the SPIRV-LLVM-Translator be supplied by the environment.

The translator is shipped as its own package (acpp-llvm-spirv) and lands in
the same prefix at bin/llvm-spirv. acpp invokes it as a subprocess and never
links it, so all the build needs is the path it bakes into llvm-to-spirv.

Two changes are needed for that, because neither is reachable from the command
line as upstream stands:

  * LLVMSPIRV_RELATIVE_INSTALLDIR is assigned with a plain set(), which creates
    a normal variable shadowing any -D cache value. Its neighbour
    LLVMSPIRV_BRANCH is guarded with if(NOT ...) three lines above; this gives
    it the same guard rather than inventing a new mechanism.

  * ExternalProject_Add, its install(CODE ...) and the add_dependencies are
    unconditional inside WITH_LLVM_TO_SPIRV, so redirecting the path alone
    would still build and install a second translator under
    lib/hipSYCL/ext/llvm-spirv. Two translators in one prefix collide on
    nothing and can diverge silently, which is worse than a file clobber.

target_compile_definitions stays outside the new guard: HIPSYCL_LLVMSPIRV_NAME
and HIPSYCL_RELATIVE_LLVMSPIRV_PATH are needed whoever built the binary.

diff --git a/src/compiler/llvm-to-backend/CMakeLists.txt b/src/compiler/llvm-to-backend/CMakeLists.txt
--- a/src/compiler/llvm-to-backend/CMakeLists.txt
+++ b/src/compiler/llvm-to-backend/CMakeLists.txt
@@ -183,7 +183,15 @@ if(WITH_SSCP_COMPILER)
     if(NOT LLVMSPIRV_BRANCH)
       set(LLVMSPIRV_BRANCH llvm_release_${LLVM_VERSION_MAJOR}0)
     endif()
-    set(LLVMSPIRV_RELATIVE_INSTALLDIR lib/hipSYCL/ext/llvm-spirv)
+    # Guarded exactly like LLVMSPIRV_BRANCH above. A plain set() creates a
+    # normal variable that shadows a -D cache value of the same name, so
+    # without this the install directory cannot be chosen from the command
+    # line. Pass "." rather than an empty string: LLVMSPIRV_RELATIVE_PATH
+    # concatenates "${LLVMSPIRV_RELATIVE_INSTALLDIR}/bin/...", and an empty
+    # value leaves a leading slash, which makes the baked path absolute.
+    if(NOT LLVMSPIRV_RELATIVE_INSTALLDIR)
+      set(LLVMSPIRV_RELATIVE_INSTALLDIR lib/hipSYCL/ext/llvm-spirv)
+    endif()
     set(LLVMSPIRV_INSTALLDIR ${CMAKE_INSTALL_PREFIX}/${LLVMSPIRV_RELATIVE_INSTALLDIR})
     set(LLVMSPIRV_PATH ${LLVMSPIRV_INSTALLDIR}/bin/llvm-spirv)
     if(WIN32)
@@ -193,6 +201,12 @@ if(WITH_SSCP_COMPILER)
     endif()
     set(LLVMSPIRV_RELATIVE_PATH ${LLVMSPIRV_RELATIVE_INSTALLDIR}/bin/${LLVMSPIRV_EXECUTABLE_NAME})
 
+    # The translator may be supplied by the environment instead of built
+    # here. It is invoked as a subprocess and never linked, so what the build
+    # needs from it is a path, and the compile definitions below still provide
+    # that. The body is left at its original indentation to keep this a
+    # two-line change.
+    if(NOT ACPP_EXTERNAL_LLVMSPIRV)
     ExternalProject_Add(LLVMSpirvTranslator
       GIT_REPOSITORY https://github.com/AdaptiveCpp/SPIRV-LLVM-Translator
       GIT_TAG origin/${LLVMSPIRV_BRANCH}
@@ -224,6 +238,7 @@ if(WITH_SSCP_COMPILER)
     ]])
 
     add_dependencies(llvm-to-spirv LLVMSpirvTranslator)
+    endif()
     target_compile_definitions(llvm-to-spirv PRIVATE
       -DHIPSYCL_LLVMSPIRV_NAME="${LLVMSPIRV_EXECUTABLE_NAME}"
       -DHIPSYCL_RELATIVE_LLVMSPIRV_PATH="${LLVMSPIRV_RELATIVE_PATH}")
